---
import BaseLayout from '../layouts/BaseLayout.astro';

const player = (ign: string, image = '/pfp/drag/drag1.jpg') => ({ ign, image });

const seasons = [
  {
    year: '2026-2027',
    status: 'Upcoming season',
    summary:
      'Tryouts have not taken place yet. The Gold and Blue rosters will be announced once selections are complete.',
    terms: [
      {
        label: 'Roster pending',
        detail: 'Tryouts upcoming',
        teams: [
          {
            name: 'UBC Gold Team',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('TBD'), player('TBD'), player('TBD')],
          },
          {
            name: 'UBC Blue Team',
            tier: null,
            tone: 'blue',
            players: [player('TBD'), player('TBD'), player('TBD')],
          },
        ],
      },
    ],
  },
  {
    year: '2025-2026',
    status: 'Previous season',
    summary: null,
    terms: [
      {
        label: 'Winter Session / Term 2',
        detail: 'Second semester',
        teams: [
          {
            name: 'UBC Gold Team',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('J'), player('Vizion'), player('ExpiredKetchup')],
          },
          {
            name: 'UBC Blue Team',
            tier: null,
            tone: 'blue',
            players: [player('Cow_B'), player('Dragussy'), player('Puffyfish14')],
          },
        ],
      },
      {
        label: 'Winter Session / Term 1',
        detail: 'First semester',
        teams: [
          {
            name: 'UBC Gold Team',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('J'), player('Vizion'), player('Cow_B')],
          },
          {
            name: 'UBC Blue Team',
            tier: null,
            tone: 'blue',
            players: [player('ExpiredKetchup'), player('simp'), player('Puffyfish14')],
          },
        ],
      },
    ],
  },
];

const missingSeasons = ['2024-2025', '2023-2024', '2022-2023', '2021-2022'];
---

<BaseLayout
  title="Teams"
  description="UBC Rocket League Gold and Blue competitive team rosters by season."
>
  <main>
    <section class="teams-hero" aria-labelledby="teams-title">
      <div class="teams-hero__content">
        <p class="eyebrow">UBC Rocket League / Competitive</p>
        <h1 id="teams-title">Meet the<br /><span>rosters.</span></h1>
        <p class="teams-hero__intro">
          Two teams. One program. Explore every player who has represented UBCRL, from the newest
          lineup back to where it all began.
        </p>
      </div>

      <div class="team-key" aria-label="Team naming convention">
        <div class="team-key__item team-key__item--gold">
          <span>01</span>
          <div>
            <strong>UBC Gold</strong>
            <small>Main roster</small>
          </div>
        </div>
        <div class="team-key__item team-key__item--blue">
          <span>02</span>
          <div>
            <strong>UBC Blue</strong>
          </div>
        </div>
      </div>

      <p class="teams-hero__order">Newest first <span aria-hidden="true">/</span> 2026 to 2021</p>
    </section>

    <section class="seasons" aria-label="Team rosters by season">
      {
        seasons.map(({ year, status, summary, terms }, seasonIndex) => (
          <article
            id={`season-${year}`}
            class:list={['season', { 'season--current': seasonIndex === 0 }]}
          >
            <header class="season__header">
              <div>
                <p class="season__status">
                  <span aria-hidden="true" />
                  {status}
                </p>
                <h2>{year}</h2>
              </div>
              {summary && <p>{summary}</p>}
              <span class="season__number" aria-hidden="true">
                {String(seasonIndex + 1).padStart(2, '0')}
              </span>
            </header>

            <div class="season__terms">
              {terms.map(({ label, detail, teams }) => (
                <section class="term" aria-label={`${year} ${label}`}>
                  <header class="term__header">
                    <h3>{label}</h3>
                    <p>{detail}</p>
                  </header>

                  <div class="team-grid">
                    {teams.map(({ name, tier, tone, players }) => (
                      <article class:list={['team-card', `team-card--${tone}`]}>
                        <header class="team-card__header">
                          <div>
                            <h4>{name}</h4>
                            {tier && <p>{tier}</p>}
                          </div>
                          <span aria-hidden="true">UBC / RL</span>
                        </header>

                        <ul class="players" aria-label={`${name} players`}>
                          {players.map(({ ign, image }) => (
                            <li class:list={['player', { 'player--pending': ign === 'TBD' }]}>
                              <div class="player__photo">
                                {image && <img src={image} alt={`Portrait of ${ign}`} loading="lazy" />}
                              </div>
                              <strong>{ign}</strong>
                            </li>
                          ))}
                        </ul>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <section id="earlier-seasons" class="archive" aria-labelledby="archive-title">
      <header class="archive__header">
        <p class="eyebrow">The memory vault</p>
        <h2 id="archive-title">Earlier<br />seasons</h2>
        <p>
          The roster sheet has temporarily escaped Ivan's memory. A search party has been
          dispatched. Names will appear here once they make it back safely.
        </p>
      </header>

      <ol class="archive__years">
        {
          missingSeasons.map((year, index) => (
            <li>
              <span>{String(index + 3).padStart(2, '0')}</span>
              <strong>{year}</strong>
              <p>Roster recall pending</p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    overflow: hidden;
    background: #05070b;
  }

  .teams-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 27rem);
    gap: clamp(3rem, 8vw, 9rem);
    min-height: calc(100svh - 4.5rem);
    padding: clamp(5rem, 10vw, 9rem) clamp(1.25rem, 7vw, 7rem) clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid #ffffff1a;
    background:
      linear-gradient(115deg, #0b101a 0%, #05070b 62%),
      #05070b;
  }

  .teams-hero::before {
    display: none;
    content: none;
  }

  .teams-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#ffffff08 1px, transparent 1px),
      linear-gradient(90deg, #ffffff08 1px, transparent 1px);
    background-size: 4rem 4rem;
    content: '';
    mask-image: linear-gradient(to right, transparent 35%, #000);
    pointer-events: none;
  }

  .teams-hero__content,
  .team-key,
  .teams-hero__order {
    position: relative;
    z-index: 1;
  }

  .teams-hero__content {
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    color: #6ba5ff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2rem;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .teams-hero h1 {
    margin: 0;
    font-size: clamp(4.5rem, 11vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .teams-hero h1 span {
    color: transparent;
    -webkit-text-stroke: clamp(1px, 0.12vw, 2px) #f5f7fb;
  }

  .teams-hero__intro {
    max-width: 41rem;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    color: #b3bccb;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.65;
  }

  .team-key {
    align-self: center;
    display: grid;
    border-top: 1px solid #ffffff29;
  }

  .team-key__item {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #ffffff29;
  }

  .team-key__item > span {
    align-self: center;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .team-key__item div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .team-key__item strong {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .team-key__item small {
    color: #828d9d;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .team-key__item--gold > span,
  .team-key__item--gold strong {
    color: #f4c542;
  }

  .team-key__item--blue > span,
  .team-key__item--blue strong {
    color: #5495ff;
  }

  .teams-hero__order {
    align-self: end;
    grid-column: 1 / -1;
    margin: 0;
    color: #7d8796;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .teams-hero__order span {
    margin: 0 0.65rem;
    color: #4d91ff;
  }

  .seasons {
    padding: clamp(4rem, 10vw, 9rem) clamp(1.25rem, 6vw, 6rem);
    background: #080b10;
  }

  .season {
    width: min(100%, 96rem);
    margin: 0 auto;
    padding-bottom: clamp(5rem, 11vw, 10rem);
  }

  .season:last-child {
    padding-bottom: 0;
  }

  .season__header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    padding: 0 4rem 2.5rem 0;
    border-bottom: 1px solid #ffffff24;
  }

  .season__status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: #8994a5;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .season__status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #687384;
  }

  .season--current .season__status {
    color: #72a8ff;
  }

  .season--current .season__status span {
    background: #4d91ff;
    box-shadow: 0 0 0 0.3rem #4d91ff21;
  }

  .season h2 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .season__header > p {
    max-width: 37rem;
    margin: 0;
    color: #9fa9b8;
    line-height: 1.7;
  }

  .season__number {
    position: absolute;
    top: 0;
    right: 0;
    color: #ffffff1c;
    font-size: 1.5rem;
    font-weight: 900;
  }

  .season__terms {
    display: grid;
    gap: 4rem;
    padding-top: 3rem;
  }

  .term {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid #ffffff17;
    background: #0b0f16;
  }

  .term__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .term__header h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .term__header p {
    margin: 0;
    color: #727e8f;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .team-card {
    --team-color: #7f8998;
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 2.2vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--team-color) 30%, transparent);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--team-color) 10%, transparent), transparent 48%),
      #080b10;
  }

  .team-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--team-color);
    content: '';
  }

  .team-card--gold {
    --team-color: #f4c542;
  }

  .team-card--blue {
    --team-color: #4d91ff;
  }

  .team-card__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .team-card__header p {
    margin: 0.4rem 0 0;
    color: var(--team-color);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .team-card h4 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .team-card__header > span {
    color: #ffffff24;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .players {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.55rem, 1.5vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .player {
    min-width: 0;
  }

  .player__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid #ffffff20;
    background:
      linear-gradient(135deg, transparent 49.5%, #ffffff0a 50%, transparent 50.5%),
      linear-gradient(45deg, transparent 49.5%, #ffffff0a 50%, transparent 50.5%),
      linear-gradient(160deg, color-mix(in srgb, var(--team-color) 10%, transparent), #0d121b);
  }

  .player__photo::before,
  .player__photo::after {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border-color: color-mix(in srgb, var(--team-color) 70%, transparent);
    content: '';
  }

  .player__photo::before {
    top: 0.45rem;
    left: 0.45rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .player__photo::after {
    right: 0.45rem;
    bottom: 0.45rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .player__photo img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .player strong {
    display: block;
    min-width: 0;
    margin-top: 0.75rem;
    overflow-wrap: anywhere;
    font-size: clamp(0.65rem, 1.15vw, 0.9rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-align: center;
  }

  .player--pending strong {
    color: #687384;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .archive {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(25rem, 1.2fr);
    gap: clamp(4rem, 10vw, 11rem);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.25rem, 7vw, 7rem);
    border-top: 1px solid #ffffff1a;
    background:
      radial-gradient(circle at 15% 25%, #174d9624, transparent 28rem),
      #05070b;
  }

  .archive__header h2 {
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 7rem);
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .archive__header > p:last-child {
    max-width: 31rem;
    margin: 2.5rem 0 0;
    color: #929cac;
    line-height: 1.75;
  }

  .archive__years {
    align-self: center;
    margin: 0;
    padding: 0;
    border-top: 1px solid #ffffff24;
    list-style: none;
  }

  .archive__years li {
    display: grid;
    grid-template-columns: 2rem minmax(8rem, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid #ffffff24;
  }

  .archive__years span {
    color: #4d91ff;
    font-size: 0.62rem;
    font-weight: 900;
  }

  .archive__years strong {
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }

  .archive__years p {
    margin: 0;
    color: #687384;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 950px) {
    .teams-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .team-key {
      width: min(100%, 32rem);
    }

    .season__header,
    .archive {
      grid-template-columns: 1fr;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .teams-hero {
      padding-top: 3.5rem;
    }

    .teams-hero h1 {
      font-size: clamp(2.8rem, 13vw, 4rem);
    }

    .season__header {
      padding-right: 0;
    }

    .season__number {
      display: none;
    }

    .term {
      margin-inline: -0.25rem;
    }

    .term__header {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .team-card__header > span {
      display: none;
    }

    .archive__years li {
      grid-template-columns: 1.5rem 1fr;
    }

    .archive__years p {
      grid-column: 2;
      text-align: left;
    }
  }
</style>

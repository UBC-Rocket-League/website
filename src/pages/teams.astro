---
import BaseLayout from '../layouts/BaseLayout.astro';

const player = (ign: string, image: string | null = '/pfp/drag/drag1.jpg') => ({ ign, image });
const historicalTeam = (name: string, tone: string, players: string[]) => ({
  name: `UBC ${name}`,
  tone,
  players,
});

const seasons = [
  {
    year: '2026-2027',
    status: 'Upcoming season',
    summary: null,
    terms: [
      {
        label: 'Tryouts upcoming:',
        detail: null,
        compactLabel: true,
        tryoutDate: 'August 25, 2026',
        tryoutTime: '8:00 PM',
        tryoutDatetime: '2026-08-25T20:00:00-07:00',
        teams: [
          {
            name: 'UBC Gold',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('TBD', null), player('TBD', null), player('TBD', null)],
          },
          {
            name: 'UBC Blue',
            tier: null,
            tone: 'blue',
            players: [player('TBD', null), player('TBD', null), player('TBD', null)],
          },
        ],
      },
    ],
  },
  {
    year: '2025-2026',
    status: 'Previous season',
    summary: null,
    terms: [
      {
        label: 'Term 2',
        detail: null,
        compactLabel: false,
        tryoutDate: null,
        tryoutTime: null,
        tryoutDatetime: null,
        teams: [
          {
            name: 'UBC Gold',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('J'), player('Vizion'), player('ExpiredKetchup')],
          },
          {
            name: 'UBC Blue',
            tier: null,
            tone: 'blue',
            players: [player('Cow_B'), player('Dragussy'), player('Puffyfish14')],
          },
        ],
      },
      {
        label: 'Term 1',
        detail: null,
        compactLabel: false,
        tryoutDate: null,
        tryoutTime: null,
        tryoutDatetime: null,
        teams: [
          {
            name: 'UBC Gold',
            tier: 'Main roster',
            tone: 'gold',
            players: [player('J'), player('Vizion'), player('Cow_B')],
          },
          {
            name: 'UBC Blue',
            tier: null,
            tone: 'blue',
            players: [player('ExpiredKetchup'), player('simp'), player('Puffyfish14')],
          },
        ],
      },
    ],
  },
];

const historicalSeasons = [
  {
    year: '2024-2025',
    terms: [
      {
        label: 'Full season',
        teams: [
          historicalTeam('Gold', 'gold', ['Cow_B', 'Harrylakers', 'J']),
          historicalTeam('Blue', 'blue', ['Dragoius', 'Puffyfish14', 'Delforge', 'Invictus']),
        ],
      },
    ],
  },
  {
    year: '2023-2024',
    terms: [
      {
        label: 'Term 2',
        teams: [
          historicalTeam('Gold', 'gold', ['Fervent', 'J', 'Harrylakers']),
          historicalTeam('Blue', 'blue', ['Deadpeople', 'Cow_B', 'Delforge']),
          historicalTeam('White', 'white', ['Dragoius', 'Blueming', 'Puffyfish14']),
        ],
      },
      {
        label: 'Term 1',
        teams: [
          historicalTeam('Gold', 'gold', ['Fervent', 'J', 'Dragoius']),
          historicalTeam('Blue', 'blue', ['Deadpeople', 'Cow_B', 'Puffyfish14']),
        ],
      },
    ],
  },
  {
    year: '2022-2023',
    terms: [
      {
        label: 'Term 2',
        teams: [
          historicalTeam('Gold', 'gold', ['Fervent', 'Ski', 'Harrylakers']),
          historicalTeam('Blue', 'blue', ['Delforge', 'Dragoius', 'Deadpeople', 'JaredP']),
          historicalTeam('Navy', 'navy', ['Zindlerr', 'Blueming', 'Puffyfish14']),
          historicalTeam('White', 'white', ['Hystrix', 'Edge', 'Rome Destroyer']),
        ],
      },
      {
        label: 'Term 1',
        teams: [
          historicalTeam('Gold', 'gold', ['Fervent', 'Ski', 'Harrylakers']),
          historicalTeam('Blue', 'blue', ['Delforge', 'Dagger', 'Deadpeople', 'JaredP']),
          historicalTeam('Navy', 'navy', ['Zindlerr', 'Blueming', 'Puffyfish14', 'Dragoius']),
          historicalTeam('White', 'white', ['Hystrix', 'Edge', 'Rome Destroyer']),
        ],
      },
    ],
  },
  {
    year: '2021-2022',
    terms: [
      {
        label: 'Term 2',
        teams: [
          historicalTeam('Gold', 'gold', ['Ski', 'Fervent', 'Frodo']),
          historicalTeam('Blue', 'blue', ['Harrylakers', 'Blueming', 'Delforge', 'Fatal MB']),
          historicalTeam('White', 'white', ['Giftedgecko', 'Hystrix', 'Rome Destroyer']),
        ],
      },
      {
        label: 'Term 1',
        teams: [
          historicalTeam('Gold', 'gold', ['Ski', 'Frodo', 'Harrylakers']),
          historicalTeam('Blue', 'blue', ['Fervent', 'Fatal MB', 'Zindlerr']),
          historicalTeam('White', 'white', ['Giftedgecko', 'Blueming', 'JaredP']),
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Teams"
  description="UBC Rocket League Gold and Blue competitive team rosters by season."
>
  <main>
    <section class="seasons" aria-label="Team rosters by season">
      {
        seasons.map(({ year, status, summary, terms }, seasonIndex) => (
          <article
            id={`season-${year}`}
            class:list={['season', { 'season--current': seasonIndex === 0 }]}
          >
            <header class="season__header">
              <div>
                <p class="season__status">
                  <span aria-hidden="true" />
                  {status}
                </p>
                <h2>{year}</h2>
              </div>
              {summary && <p>{summary}</p>}
            </header>

            <div class="season__terms">
              {terms.map(
                ({
                  label,
                  detail,
                  compactLabel,
                  tryoutDate,
                  tryoutTime,
                  tryoutDatetime,
                  teams,
                }) => (
                <section
                  class="term"
                  aria-label={`${year} ${label}${tryoutDate ? ` on ${tryoutDate} at ${tryoutTime}` : ''}`}
                >
                  <header class="term__header">
                    {compactLabel ? (
                      <p>{label}</p>
                    ) : (
                      <h3>{label}</h3>
                    )}
                    {tryoutDate && tryoutTime && tryoutDatetime ? (
                      <p>
                        <time datetime={tryoutDatetime}>{tryoutDate} / {tryoutTime}</time>
                      </p>
                    ) : (
                      detail && <p>{detail}</p>
                    )}
                  </header>

                  <div class="team-grid">
                    {teams.map(({ name, tier, tone, players }) => (
                      <article class:list={['team-card', `team-card--${tone}`]}>
                        <header class="team-card__header">
                          <div>
                            <h4>{name}</h4>
                            {tier && <p>{tier}</p>}
                          </div>
                        </header>

                        <ul class="players" aria-label={`${name} players`}>
                          {players.map(({ ign, image }) => (
                            <li class:list={['player', { 'player--pending': ign === 'TBD' }]}>
                              <div class="player__photo">
                                {image && <img src={image} alt={`Portrait of ${ign}`} loading="lazy" />}
                              </div>
                              <strong>{ign}</strong>
                            </li>
                          ))}
                        </ul>
                      </article>
                    ))}
                  </div>
                </section>
                ),
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section id="earlier-seasons" class="archive" aria-label="Earlier season rosters">
      <div class="archive__years">
        {
          historicalSeasons.map(({ year, terms }) => (
            <details class="archive-season">
              <summary>
                <strong>{year}</strong>
                <span class="archive-season__toggle" aria-hidden="true" />
              </summary>

              <div class="archive-season__body">
                {terms.map(({ label, teams }) => (
                  <section class="archive-term" aria-label={`${year} ${label}`}>
                    <header class="archive-term__header">
                      <h3>{label}</h3>
                    </header>

                    <div class="team-grid">
                      {teams.map(({ name, tone, players }) => (
                        <article class:list={['team-card', 'team-card--historical', `team-card--${tone}`]}>
                          <header class="team-card__header">
                            <h4>{name}</h4>
                          </header>

                          <ul class="historical-players" aria-label={`${name} players`}>
                            {players.map((ign) => (
                              <li>
                                <strong>{ign}</strong>
                              </li>
                            ))}
                          </ul>
                        </article>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    overflow: hidden;
    background: #05070b;
  }

  .seasons {
    padding: clamp(4rem, 10vw, 9rem) clamp(1.25rem, 6vw, 6rem);
    background: #080b10;
  }

  .season {
    width: min(100%, 96rem);
    margin: 0 auto;
    padding-bottom: clamp(5rem, 11vw, 10rem);
  }

  .season:last-child {
    padding-bottom: 0;
  }

  .season__header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    padding: 0 0 2.5rem;
    border-bottom: 1px solid #ffffff24;
  }

  .season__status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: #8994a5;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .season__status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #687384;
  }

  .season--current .season__status {
    color: #72a8ff;
  }

  .season--current .season__status span {
    background: #4d91ff;
    box-shadow: 0 0 0 0.3rem #4d91ff21;
  }

  .season h2 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .season__header > p {
    max-width: 37rem;
    margin: 0;
    color: #9fa9b8;
    line-height: 1.7;
  }

  .season__terms {
    display: grid;
    gap: 4rem;
    padding-top: 3rem;
  }

  .term {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid #ffffff17;
    background: #0b0f16;
  }

  .term__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .term__header h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .term__header p {
    margin: 0;
    color: #727e8f;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .team-card {
    --team-color: #7f8998;
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 2.2vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--team-color) 30%, transparent);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--team-color) 10%, transparent), transparent 48%),
      #080b10;
  }

  .team-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--team-color);
    content: '';
  }

  .team-card--gold {
    --team-color: #f4c542;
  }

  .team-card--blue {
    --team-color: #4d91ff;
  }

  .team-card--navy {
    --team-color: #344f8f;
  }

  .team-card--white {
    --team-color: #dce3ed;
  }

  .team-card__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .team-card__header p {
    margin: 0.4rem 0 0;
    color: var(--team-color);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .team-card h4 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .players {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.55rem, 1.5vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .player {
    min-width: 0;
  }

  .player__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid #ffffff20;
    background:
      linear-gradient(135deg, transparent 49.5%, #ffffff0a 50%, transparent 50.5%),
      linear-gradient(45deg, transparent 49.5%, #ffffff0a 50%, transparent 50.5%),
      linear-gradient(160deg, color-mix(in srgb, var(--team-color) 10%, transparent), #0d121b);
  }

  .player__photo::before,
  .player__photo::after {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border-color: color-mix(in srgb, var(--team-color) 70%, transparent);
    content: '';
  }

  .player__photo::before {
    top: 0.45rem;
    left: 0.45rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .player__photo::after {
    right: 0.45rem;
    bottom: 0.45rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .player__photo img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .player strong {
    display: block;
    min-width: 0;
    margin-top: 0.75rem;
    overflow-wrap: anywhere;
    font-size: clamp(0.65rem, 1.15vw, 0.9rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-align: center;
  }

  .player--pending strong {
    color: #687384;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .archive {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.25rem, 6vw, 6rem);
    border-top: 1px solid #ffffff1a;
    background:
      radial-gradient(circle at 15% 25%, #174d9624, transparent 28rem),
      #05070b;
  }

  .archive__years {
    width: min(100%, 96rem);
    min-width: 0;
    margin: 0 auto;
    padding: 0;
    border-top: 1px solid #ffffff24;
  }

  .archive-season {
    border-bottom: 1px solid #ffffff24;
  }

  .archive-season summary {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  .archive-season summary::-webkit-details-marker {
    display: none;
  }

  .archive-season summary:focus {
    outline: none;
  }

  .archive-season summary:focus-visible {
    outline: 2px solid #4d91ff;
    outline-offset: 0.35rem;
  }

  .archive-season summary strong {
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .archive-season__toggle {
    position: relative;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    color: #4d91ff;
    transition: transform 180ms ease;
  }

  .archive-season__toggle::before,
  .archive-season__toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
  }

  .archive-season__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .archive-season[open] .archive-season__toggle {
    transform: rotate(45deg);
  }

  .archive-season__body {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.5rem, 3vw, 3rem);
    border-top: 1px solid #ffffff17;
    background: #080b10;
  }

  .archive-season .team-grid {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 20rem));
    align-items: stretch;
    justify-content: start;
  }

  .archive-term__header {
    margin-bottom: 1rem;
  }

  .archive-term__header h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .team-card--historical .team-card__header {
    min-height: 0;
    margin-bottom: 1rem;
  }

  .team-card--historical {
    display: flex;
    flex-direction: column;
  }

  .historical-players {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    border-top: 1px solid #ffffff14;
    list-style: none;
  }

  .historical-players li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.7rem 0.6rem;
    border-bottom: 1px solid #ffffff14;
  }

  .historical-players li::before {
    flex: 0 0 auto;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--team-color);
    content: '';
  }

  .historical-players strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 950px) {
    .season__header {
      grid-template-columns: 1fr;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .term {
      margin-inline: -0.25rem;
    }

    .term__header {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .archive-season .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

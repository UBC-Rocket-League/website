---
import ferventVideo from '../../fervent.mp4?url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Clips" description="UBC Rocket League clips.">
  <main
    class:list={[
      'min-h-[calc(100svh-4.5rem)]',
      'px-[clamp(1.25rem,6vw,6rem)] py-[clamp(3rem,8vw,7rem)]',
      'max-[800px]:pt-16',
    ]}
  >
    <header class="mx-auto w-full max-w-[80rem]">
      <h1
        class:list={[
          'mt-0 mb-[clamp(2rem,6vw,5rem)]',
          'text-[clamp(3.5rem,10vw,8rem)] leading-[0.9] font-bold',
          'tracking-[-0.07em] uppercase',
        ]}
      >
        Clips
      </h1>
      <!-- TODO: Add clip titles, dates, players, event details, and more videos. -->
    </header>

    <article
      class:list={[
        'mx-auto w-full max-w-[80rem] overflow-hidden',
        'border border-[#ffffff24] bg-[#0c1018]',
      ]}
    >
      <video
        class="block aspect-video w-full bg-black object-cover"
        src={ferventVideo}
        controls
        playsinline
        preload="metadata"></video>
      <div class="p-5">
        <h2 class="m-0 text-[1.25rem] font-bold uppercase">Fervent</h2>
        <p class="mt-[0.4rem] mb-0 text-[#aeb6c4]">UBCRL clip.</p>
      </div>
    </article>
  </main>
</BaseLayout>

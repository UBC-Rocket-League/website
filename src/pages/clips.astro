---
import ferventVideo from '../../fervent.mp4?url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Clips" description="UBC Rocket League clips.">
  <main class="clips-page">
    <header class="clips-header">
      <h1>Clips</h1>
      <!-- TODO: Add clip titles, dates, players, event details, and more videos. -->
    </header>

    <article class="clip">
      <video src={ferventVideo} controls playsinline preload="metadata"></video>
      <div class="clip__details">
        <h2>Fervent</h2>
        <p>UBCRL clip.</p>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .clips-page {
    min-height: calc(100svh - 4.5rem);
    padding: clamp(3rem, 8vw, 7rem) clamp(1.25rem, 6vw, 6rem);
  }

  .clips-header,
  .clip {
    width: min(100%, 80rem);
    margin-inline: auto;
  }

  h1 {
    margin: 0 0 clamp(2rem, 6vw, 5rem);
    font-size: clamp(3.5rem, 10vw, 8rem);
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .clip {
    overflow: hidden;
    border: 1px solid #ffffff24;
    background: #0c1018;
  }

  .clip video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    object-fit: cover;
  }

  .clip__details {
    padding: 1.25rem;
  }

  .clip__details h2,
  .clip__details p {
    margin: 0;
  }

  .clip__details h2 {
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .clip__details p {
    margin-top: 0.4rem;
    color: #aeb6c4;
  }

  @media (max-width: 800px) {
    .clips-page {
      padding-top: 4rem;
    }
  }
</style>

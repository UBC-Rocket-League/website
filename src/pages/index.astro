---
import BaseLayout from '../layouts/BaseLayout.astro';
import RlHomescreenBtn from '../components/buttons/rl-homescreen-btn';
import ChallengeCard from '../components/cards/challenge-card';
---

<BaseLayout
  title="UBC RL"
  description="Home of the UBC Rocket League community."
  overlayHeader
>
  <main>
    <section class="hero">
      <video
        class="hero__bg-video"
        src="/videos/bg-clip-1.mp4"
        autoplay
        muted
        loop
        playsinline
      ></video>

      <div class="hero__button-stack">
        <RlHomescreenBtn variant="default" align="left" opacity={0.9} subtext="THE HOME SCREEN" >HOME</RlHomescreenBtn>
        <RlHomescreenBtn variant="default" align="left" opacity={0.9}>TEAM</RlHomescreenBtn>
        <RlHomescreenBtn variant="default" align="left" opacity={0.9}>CALENDAR</RlHomescreenBtn>
        <RlHomescreenBtn variant="default" align="left" opacity={0.9}>ACHIEVEMENTS</RlHomescreenBtn>
        <RlHomescreenBtn variant="default" align="left" opacity={0.9}>MERCH</RlHomescreenBtn>
      </div>

      <div class="hero__card">
        <ChallengeCard client:load />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 100svh;
    padding: 0 3rem;
    background: #05070b;
  }

  .hero__bg-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .hero__button-stack {
    position: relative;
    top: 60svh;
    display: flex;
    flex-direction: column;
    flex: none;
    align-self: flex-start;
    gap: 6px;
    margin: 0;
    transform: translateY(-50%);
  }

  .hero__card {
    min-width: 0;
    margin: 0;
  }

  @media (max-width: 800px) {
    .hero {
      flex-direction: column;
      justify-content: center;
      padding: 3rem 1.5rem;
    }

    .hero__button-stack {
      position: static;
      align-self: center;
      transform: none;
    }
  }
</style>

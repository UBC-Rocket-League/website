---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroImage = "/banners/ubcrl_banner_1.JPG";

const heroSlides = [
  {
    title: "Welcome to UBC Rocket League",
    subtitle: "Placeholder hero copy goes here.",
  },
  {
    title: "Compete. Practice. Improve.",
    subtitle: "Placeholder hero copy goes here.",
  },
  {
    title: "Join a Community of Ballers",
    subtitle: "Placeholder hero copy goes here.",
  },
];

const exploreCards = [
  {
    title: "About Us",
    description: "Who we are and what UBC Rocket League is all about.",
  },
  {
    title: "Our Teams",
    description: "Meet the squads competing across every division.",
  },
  {
    title: "Get Merch",
    description: "Rep the crest with our latest team gear.",
  },
];

const upcomingCards = [
  { title: "Weekly Scrims", meta: "Tue, 7:00 PM" },
  { title: "Fall Tryouts", meta: "Sept 5–7" },
  { title: "LAN Watch Party", meta: "Sept 12" },
];

const recentCards = [
  { title: "Fall Kickoff Recap", meta: "Aug 30" },
  { title: "Alumni Showcase", meta: "Aug 18" },
  { title: "3v3 Ladder Results", meta: "Aug 10" },
];
---

<BaseLayout
  title="UBC RL"
  description="Home of the UBC Rocket League community."
>
  <main
    class:list={[
      "bg-white text-black",
      "lg:h-[calc(100svh-6.1rem)] lg:overflow-hidden",
    ]}
  >
    <div class="flex flex-col lg:h-full lg:flex-row">
      <!-- Main container: ~5/6 width -->
      <section
        class="flex flex-col lg:h-full lg:flex-[5] lg:border-r-2 lg:border-black"
      >
        <!-- Hero carousel: top 2/3 -->
        <div
          id="hero-carousel"
          class="relative h-[70vh] overflow-hidden bg-black sm:h-[60vh] lg:h-auto lg:min-h-0 lg:flex-[7]"
        >
          {
            heroSlides.map((slide, i) => (
              <div
                data-slide={i}
                class:list={[
                  "absolute inset-0 transition-opacity duration-700",
                  i === 0 ? "opacity-100" : "pointer-events-none opacity-0",
                ]}
              >
                <img
                  src={heroImage}
                  alt=""
                  class="h-full w-full object-cover"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <div class="absolute inset-y-0 left-0 flex items-center">
                  <div class="m-4 max-w-md border-2 border-black bg-white/90 px-6 py-5 sm:m-8 sm:px-8 sm:py-6">
                    <p class="text-2xl font-black tracking-tight uppercase sm:text-4xl">
                      {slide.title}
                    </p>
                    <p class="mt-2 text-sm text-black/80 sm:text-base">
                      {slide.subtitle}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Subheader + 3 cards: bottom 1/3 -->
        <div class="flex flex-col lg:min-h-0 lg:flex-[4]">
          <div
            class="flex items-center justify-between gap-4 border-b-2 border-black px-4 pt-4 pb-2 sm:px-6"
          >
            <h2 class="text-lg font-black tracking-wide uppercase sm:text-xl">
              Explore UBC RL
            </h2>
            <div
              id="hero-dots"
              class="flex gap-2"
              role="tablist"
              aria-label="Hero slides"
            >
              {
                heroSlides.map((_, i) => (
                  <button
                    type="button"
                    data-dot={i}
                    class:list={[
                      "h-1.5 w-8 border-2 border-black",
                      i === 0 ? "bg-black" : "bg-white",
                    ]}
                    aria-label={`Go to slide ${i + 1}`}
                  />
                ))
              }
            </div>
          </div>
          <div
            class:list={[
              "grid flex-1 grid-cols-1 gap-4 p-4 sm:grid-cols-3 sm:px-6 sm:py-4",
              "lg:min-h-0 lg:auto-rows-fr lg:overflow-hidden",
            ]}
          >
            {
              exploreCards.map((card) => (
                <article class="flex h-full min-h-0 flex-col border-2 border-black bg-neutral-100">
                  <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto lg:min-h-0 lg:flex-1">
                    <img
                      src={heroImage}
                      alt=""
                      class="absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex-none border-t-2 border-black p-2 sm:p-3">
                    <p class="text-sm font-bold uppercase tracking-wide sm:text-base">
                      {card.title}
                    </p>
                    <p class="mt-1 text-xs text-black/70 sm:text-sm">
                      {card.description}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Sidebar: ~1/6 width -->
      <aside
        class="flex flex-col border-t-2 border-black lg:h-full lg:flex-1 lg:border-t-0 lg:border-l-2"
      >
        <div class="flex flex-1 flex-col lg:min-h-0 lg:overflow-hidden">
          <h2
            class="border-b-2 border-black px-3 pt-3 pb-2 text-sm font-black tracking-wide uppercase sm:text-base"
          >
            Upcoming Activities
          </h2>
          <div
            class="flex flex-1 flex-col gap-2 p-2 lg:min-h-0 lg:overflow-hidden lg:px-4"
          >
            {
              upcomingCards.map((card) => (
                <article class="flex h-20 min-h-0 flex-row items-stretch border-2 border-black bg-neutral-100 lg:h-auto lg:flex-1">
                  <div class="min-w-0 flex-1 p-2">
                    <p class="line-clamp-2 text-xs font-bold uppercase tracking-wide">
                      {card.title}
                    </p>
                    <p class="mt-1 text-[0.65rem] text-black/70">{card.meta}</p>
                  </div>
                  <div class="w-16 flex-none border-l-2 border-black">
                    <img
                      src={heroImage}
                      alt=""
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div
          class="flex flex-1 flex-col border-t-2 border-black lg:min-h-0 lg:overflow-hidden"
        >
          <h2
            class="border-b-2 border-black px-3 pt-3 pb-2 text-sm font-black tracking-wide uppercase sm:text-base"
          >
            Recent Activities
          </h2>
          <div
            class="flex flex-1 flex-col gap-2 p-2 lg:min-h-0 lg:overflow-hidden lg:px-4"
          >
            {
              recentCards.map((card) => (
                <article class="flex h-20 min-h-0 flex-row items-stretch border-2 border-black bg-neutral-100 lg:h-auto lg:flex-1">
                  <div class="min-w-0 flex-1 p-2">
                    <p class="line-clamp-2 text-xs font-bold uppercase tracking-wide">
                      {card.title}
                    </p>
                    <p class="mt-1 text-[0.65rem] text-black/70">{card.meta}</p>
                  </div>
                  <div class="w-16 flex-none border-l-2 border-black">
                    <img
                      src={heroImage}
                      alt=""
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </main>

  <script>
    const slides = document.querySelectorAll<HTMLElement>(
      "#hero-carousel [data-slide]",
    );
    const dots = document.querySelectorAll<HTMLButtonElement>(
      "#hero-dots [data-dot]",
    );

    let active = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      active = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle("opacity-100", i === active);
        slide.classList.toggle("opacity-0", i !== active);
        slide.classList.toggle("pointer-events-none", i !== active);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-black", i === active);
        dot.classList.toggle("bg-white", i !== active);
      });
    }

    function start() {
      timer = setInterval(() => show(active + 1), 5000);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        clearInterval(timer);
        start();
      });
    });

    start();
  </script>
</BaseLayout>

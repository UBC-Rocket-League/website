---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="UBC RL"
  description="Home of the UBC Rocket League community."
  overlayHeader
>
  <main>
    <section class="hero">
      <div class="hero__content">
        <div class="hero__copy">
          <h1>Our homepage went for boost.</h1>
          <p class="hero__punchline">
            It'll rotate back eventually. Unlike your solo queue teammate.
          </p>
        </div>

        <figure class="hero__art">
          <svg
            viewBox="0 0 640 610"
            role="img"
            aria-labelledby="underwear-title underwear-description"
          >
            <title id="underwear-title">UBC Rocket League underwear</title>
            <desc id="underwear-description">
              A pair of white boxer briefs printed with the UBC Rocket League crest.
            </desc>
            <defs>
              <linearGradient id="fabric" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="0.55" stop-color="#e8edf5" />
                <stop offset="1" stop-color="#b8c5d8" />
              </linearGradient>
              <linearGradient id="waistband" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1f65a7" />
                <stop offset="1" stop-color="#102e61" />
              </linearGradient>
              <filter id="underwear-shadow" x="-20%" y="-20%" width="140%" height="150%">
                <feDropShadow dx="0" dy="18" stdDeviation="16" flood-color="#000" flood-opacity="0.42" />
              </filter>
            </defs>

            <ellipse cx="320" cy="551" rx="238" ry="24" fill="#000" opacity="0.24" />
            <g filter="url(#underwear-shadow)">
              <path
                d="M92 142 H548 L526 516 H368 L351 366 Q320 338 289 366 L272 516 H114 Z"
                fill="url(#fabric)"
                stroke="#d6dfeb"
                stroke-width="6"
                stroke-linejoin="round"
              />
              <path
                d="M102 164 L121 492 H273 L289 366 Q320 338 351 366 L367 492 H519 L538 164"
                fill="none"
                stroke="#aab8cb"
                stroke-width="4"
              />
              <path
                d="M277 161 C270 239 278 323 320 366 C362 323 370 239 363 161 Z"
                fill="#d5deea"
                stroke="#aab8cb"
                stroke-width="4"
              />
              <path
                d="M328 177 C350 224 346 294 315 334"
                fill="none"
                stroke="#95a5ba"
                stroke-width="5"
                stroke-linecap="round"
              />
              <path d="M119 476 H276" stroke="#f58a1f" stroke-width="9" />
              <path d="M364 476 H521" stroke="#f58a1f" stroke-width="9" />
              <path d="M111 200 C163 187 211 189 258 207" fill="none" stroke="#fff" stroke-width="8" opacity="0.45" />
              <path d="M382 203 C429 188 478 188 530 201" fill="none" stroke="#fff" stroke-width="8" opacity="0.32" />
              <rect x="68" y="62" width="504" height="108" rx="18" fill="url(#waistband)" />
              <path d="M80 91 H560" stroke="#ffffff" stroke-width="5" opacity="0.85" />
              <path d="M80 145 H560" stroke="#0b2149" stroke-width="6" opacity="0.7" />
              <text
                x="320"
                y="134"
                fill="#ffffff"
                font-family="Arial, Helvetica, sans-serif"
                font-size="38"
                font-weight="800"
                letter-spacing="9"
                text-anchor="middle"
              >UBC / RL</text>
              <image
                href="/ubc-rl-crest.png"
                x="132"
                y="234"
                width="150"
                height="155"
                preserveAspectRatio="xMidYMid meet"
              />
              <path d="M410 257 L492 242" stroke="#b5c1d1" stroke-width="6" stroke-linecap="round" opacity="0.6" />
              <path d="M411 284 L500 271" stroke="#b5c1d1" stroke-width="5" stroke-linecap="round" opacity="0.45" />
            </g>
          </svg>
          <figcaption>Officially unofficial team kit</figcaption>
        </figure>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: 100svh;
    padding: clamp(9rem, 18vw, 14rem) clamp(1.25rem, 8vw, 8rem) 5rem;
    place-items: center;
    background:
      radial-gradient(circle at 75% 65%, #1c5db833, transparent 34rem),
      linear-gradient(135deg, #080b10 0%, #05070b 60%, #0a1830 100%);
  }

  .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: min(100%, 78rem);
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 7rem);
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .hero__punchline {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: #aeb6c4;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  .hero__art {
    width: 100%;
    margin: 0;
    transform: rotate(2deg);
  }

  .hero__art svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__art figcaption {
    margin-top: -1rem;
    color: #718096;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 850px) {
    .hero {
      padding-top: 11rem;
    }

    .hero__content {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .hero__art {
      width: min(100%, 28rem);
      margin-inline: auto;
      transform: rotate(1deg);
    }
  }
</style>

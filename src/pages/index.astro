---
import ferventVideo from '../../fervent.mp4?url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="UBC RL"
  description="Home of the UBC Rocket League community."
  overlayHeader
>
  <main>
    <section class="hero" aria-label="Fervent">
      <video
        class="hero-video"
        src={ferventVideo}
        autoplay
        muted
        controls
        playsinline
        preload="auto"
      ></video>
    </section>
  </main>

  <script>
    const video = document.querySelector<HTMLVideoElement>('.hero-video');
    let completedPlays = 0;

    video?.addEventListener('ended', () => {
      completedPlays += 1;

      if (completedPlays < 3) {
        video.currentTime = 0;
        void video.play();
      }
    });
  </script>
</BaseLayout>

<style>
  .hero {
    width: 100%;
    height: 100svh;
    overflow: hidden;
  }

  .hero-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

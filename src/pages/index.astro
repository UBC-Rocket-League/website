---
import ferventVideo from '../../fervent.mp4?url';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>UBC RL</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-label="Fervent">
        <video
          class="hero-video"
          src={ferventVideo}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
      </section>
    </main>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    min-height: 100svh;
    background: #000;
    cursor: url('/car-cursor.svg') 24 7, auto;
  }

  .hero {
    width: 100%;
    height: 100svh;
    overflow: hidden;
  }

  .hero-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

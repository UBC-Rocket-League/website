---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Merch" description="UBC Rocket League merchandise.">
  <main
    class="grid min-h-[calc(100svh-4.5rem)] place-content-center bg-[linear-gradient(135deg,transparent_60%,#0d3d811f),#05070b] px-[clamp(1.25rem,8vw,8rem)] py-[clamp(3rem,10vw,8rem)] max-[800px]:min-h-svh max-[800px]:pt-40"
  >
    <div class="w-full max-w-[56rem]">
      <h1
        class="m-0 text-[clamp(3.5rem,11vw,8rem)] leading-[0.9] font-bold tracking-[-0.07em] uppercase"
      >
        Merch
      </h1>
      <p
        class="mt-8 mb-0 max-w-[42rem] text-[clamp(1rem,2vw,1.25rem)] leading-[1.6] text-[#aeb6c4]"
      >
        UBCRL merchandise and ordering information will live here.
      </p>
      <!-- TODO: Add products, photos, prices, sizing, availability, and an order link. -->
    </div>
  </main>
</BaseLayout>
